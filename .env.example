# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telecom_logs

# Server
PORT=3000
HOST=0.0.0.0

# Batching configuration
BATCH_SIZE=500
BATCH_INTERVAL_MS=100

# Request size limit (bytes) - 1MB default
MAX_REQUEST_SIZE=1048576

# Request timeout (ms)
REQUEST_TIMEOUT_MS=30000
